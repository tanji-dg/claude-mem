{
	"compilerOptions": {
		"target": "es2024",
		"lib": ["es2024"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"allowJs": true,
		"checkJs": false,
		"noEmit": true,
		"isolatedModules": true,
		"allowSyntheticDefaultImports": true,
		"forceConsistentCasingInFileNames": true,
		"allowImportingTsExtensions": true,
		"strict": true,
		"skipLibCheck": true,
		"types": [],
		// Files reused from the repo's root src/ import these packages; the repo
		// root may have no node_modules, so resolve them from this package.
		"paths": {
			"zod": ["./node_modules/zod"],
			"@modelcontextprotocol/sdk/*": ["./node_modules/@modelcontextprotocol/sdk/dist/esm/*"]
		}
	},
	// vitest.config.ts runs in Node (node:fs, node:path) and this config has no
	// Node types, so it is left to vitest's own loader.
	"include": ["src/**/*.ts", "test/**/*.ts", "worker-configuration.d.ts"]
}
